{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halloween-rush",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get dist/404.html with a real 404 status, so search engines never index them as copies of the game.
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
